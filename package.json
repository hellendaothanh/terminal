{
  "name": "omni-terminal",
  "private": true,
  "version": "1.5.9",
  "description": "Cross-platform Server & Database Management Tool integrating SSH, SFTP, RDP, MySQL, PostgreSQL, Redis, MongoDB and AI Assistant",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "author": "Hautp",
  "scripts": {
    "dev": "vite",
    "compile": "tsc && vite build",
    "build": "npm run compile && electron-builder",
    "build:win": "npm run compile && electron-builder --win",
    "build:mac": "npm run compile && electron-builder --mac",
    "build:all": "npm run compile && electron-builder -mw",
    "release:patch": "npm version patch && git push origin main --tags",
    "release:minor": "npm version minor && git push origin main --tags",
    "release:major": "npm version major && git push origin main --tags",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "lint:security": "npm audit",
    "postinstall": "node -e \"const fs = require('fs'); if (fs.existsSync('node_modules/electron')) { const exe = process.platform === 'darwin' ? 'Electron.app/Contents/MacOS/Electron' : (process.platform === 'win32' ? 'electron.exe' : 'electron'); fs.writeFileSync('node_modules/electron/path.txt', exe); }\""
  },
  "build": {
    "appId": "com.omniterminal.app",
    "productName": "OmniTerminal",
    "npmRebuild": false,
    "directories": {
      "output": "dist-app"
    },
    "publish": null,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/lib-storage": "^3.1107.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "ioredis": "^6.0.0",
    "ipv6": "^3.1.3",
    "lucide-react": "^0.469.0",
    "mysql2": "^3.23.3",
    "otplib": "^12.0.1",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socks": "^2.8.9",
    "socks-server": "^0.0.2",
    "socksv5": "^0.0.4",
    "ssh2": "^1.15.0",
    "ssh2-sftp-client": "^10.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ssh2": "^1.11.10",
    "@types/ssh2-sftp-client": "^9.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint-plugin-security": "^4.0.1",
    "tree-kill": "^1.2.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.15.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "ssh2@1.17.0": true,
    "electron-winstaller@5.4.0": true
  }
}
